[core]
class: CustomUnitMetadata
tags: drone, SPARK

price: 0
mass: 1

techLevel: 1
buildSpeed: 0s

energyRegen: 0
energyStartingPercentage: 1
# energyMax: need energy

# disableAllUnitCollisions: true
isUnselectable: true

isBio: false
isBuilding: false
showOnMinimap: false
fogOfWarSightRange: 1
ignoreInUnitCapCalculation: true
showInEditor: false

@memory deck : unit

[graphics]
total_frames: 1
# image: need an image
image_wreak: NONE
image_shadow: AUTO
drawLayer: top

[hiddenAction_needFather]
autoTrigger: if memory.deck==null or memory.deck.parent==null
deleteSelf: true

[hiddenAction_dead]
autoTriggerOnEvent: destroyed
requireConditional: if not memory.deck.hasFlag(id=25)
takeResources: drone_num = -1
takeResources_discardCollected: true
takeResources_includeReference: memory.deck

[hiddenAction_rechargeEnergy]
autoTrigger: if self.hasParent()
addEnergy: 1

[hiddenAction_setDeck]
autoTriggerOnEvent: created
setUnitMemory: deck = self.customTarget1

[hiddenAction_back]
autoTrigger: if (not self.hasActiveWaypoint(type="loadInto")) and ((not memory.deck.parent.isAttacking()) or memory.deck.hasFlag(id=24) or memory.deck.hasFlag(id=25) or self.energy() < 1)
clearAllWaypoints: true
addWaypoint_type: loadInto
addWaypoint_target_fromReference: memory.deck

[hiddenAction_attack]
autoTrigger: if (not (memory.deck.hasFlag(id=24) or memory.deck.hasFlag(id=25))) and (not self.hasActiveWaypoint(type="attack")) and self.isEnergyFull() and memory.deck.parent.isAttacking()
clearAllWaypoints: true
addWaypoint_type: attack
addWaypoint_target_fromReference: memory.deck.parent.attacking

[resource_drone_num]
hidden: false